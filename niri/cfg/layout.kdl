    layout {
        gaps 16 // Gap between windows
        center-focused-column "never" // Don’t auto-center focused column

        background-color "transparent" // <- needed for noctalia-shell to set wallpaper

        focus-ring {
            on
            width 4
            active-color "#ebbcba"   // Rose Pine Classic: primary
            inactive-color "#6e6a86" // Rose Pine Classic: outline
            urgent-color "#eb6f92"   // Rose Pine Classic: error
        }

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

        struts {}
    }
